{
  "description": "Left Option + numbers → focus applications",
  "title": "App Launcher",
  "rules": [
    {
      "description": "Left Option + numbers → focus applications",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "com.google.Chrome"
                }
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "2",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "net.kovidgoyal.kitty"
                }
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "3",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "com.todesktop.230313mzl4w4u92"
                }
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "4",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "com.tinyspeck.slackmacgap"
                }
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "5",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "software_function": {
                "open_application": {
                  "bundle_identifier": "com.linear"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
