theme = Catppuccin Frappe
font-family = Fira Code
font-size = 12

custom-shader = ~/.config/ghostty/ghostty-cursor-shaders/ghostty/cursor_sweep.glsl


# modify_font underline_position 4
# modify_font underline_thickness 100%
# hide_window_decorations yes
# kitty_mod ctrl+shift
# map kitty_mod+r
# map opt+cmd+l clear_terminal to_cursor_scroll active
# macos-option-as-alt = right
# Optional theme file generated by `kitten themes` (absent on a fresh clone).
# globinclude current-theme.conf
# cursor_trail 1
# 
# Padding around terminal content
# window_padding_width 4
# window_margin_width 2
# placement_strategy center
# 
# tab_bar_style powerline
# tab_powerline_style round
# 
# scrollback_lines 10000
# enable_audio_bell no
