theme = Catppuccin Frappe
font-family = Fira Code
font-size = 12

custom-shader = ~/.config/ghostty/ghostty-cursor-shaders/ghostty/cursor_sweep.glsl

# Font underline adjustments
adjust-underline-position = 2
adjust-underline-thickness = 50%

# Window decorations
macos-titlebar-style = hidden

# Clear screen (also clears scrollback; see note below)
keybind = alt+super+l=clear_screen

# Treat only Right Option as Alt
macos-option-as-alt = right

# Window padding
window-padding-x = 4
window-padding-y = 4

# Center excess padding
window-padding-balance = true

# Scrollback (Ghostty uses bytes, not lines)
scrollback-limit = 10485760

# Disable audible bells
# bell-features = no-system,no-audio
