[user]
	signingkey = /Users/rafal/.ssh/github_signing.pub
[alias]
  g = grep --recurse-submodules
  st = status
  co = checkout
  ci = commit
  br = branch
  di = difftool
  suup = submodule update --remote --merge --init
  subupd = submodule update --recursive --init
  tree = log --oneline --decorate --all --graph --pretty=format:'%Cred%h%Creset %s -%C(yellow)%d%Creset %Cgreen(%cr)'
  plog = log --pretty=format:'%Cred%h%Creset %s -%C(yellow)%d%Creset %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
[credential]
  helper = store
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true  # use n and N to move between diff sections
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
[gpg]
	format = ssh
[commit]
	gpgsign = true
